{
  "name": "@quinelings/agent-sdk",
  "version": "1.0.0",
  "description": "Typed thought-to-lifeform runtime with MCP and A2A adapters",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./a2a": {
      "types": "./dist/a2a.d.ts",
      "import": "./dist/a2a.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1.js"
    },
    "./v1-schema": {
      "types": "./dist/v1-schema.d.ts",
      "import": "./dist/v1-schema.js"
    },
    "./v1-mcp": {
      "types": "./dist/v1-mcp.d.ts",
      "import": "./dist/v1-mcp.js"
    },
    "./v1-a2a": {
      "types": "./dist/v1-a2a.d.ts",
      "import": "./dist/v1-a2a.js"
    },
    "./v1-migrate": {
      "types": "./dist/v1-migrate.d.ts",
      "import": "./dist/v1-migrate.js"
    },
    "./v1-ranch": {
      "types": "./dist/v1-ranch.d.ts",
      "import": "./dist/v1-ranch.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js"
    }
  },
  "bin": {
    "quinelings-mcp": "./dist/mcp-cli.js",
    "quinelings-a2a": "./dist/a2a-cli.js",
    "quinelings-v1-mcp": "./dist/v1-mcp-cli.js",
    "quinelings-v1-a2a": "./dist/v1-a2a-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test": "tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@a2a-js/sdk": "1.3.0",
    "express": "5.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "@types/node": "22.19.0",
    "@types/express": "5.0.5"
  }
}
