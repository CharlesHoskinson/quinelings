  "projectionRules": {
    "freshness": "observedAt <= now and now-observedAt <= maxAge and revision >= minRevision; all boundaries inclusive",
    "gather": "ready iff fresh and available and not reserved and reachable and capacity and ownerAllowed; simulatedReceipts is ready ? 1 : 0 for explicitly allowed local simulation",
    "craft": "error invalid-recipe for perBatch <= 0; otherwise feasible=min(requested,floor(each available/perBatch),floor(freeCapacity/netPerBatch)); absent availability means 0; consumption=feasible*perBatch, confirmed=0",
    "mission": "exact done claim assessed under evidenceFresh policy, complete iff state supported; planSaysDone is not evidence",
    "evidence": "evidenceFresh distinct-source/claim counting as defined in stdlib.md, not legacy first-report evidence; null is unknown",
    "route": "stale snapshot produces stale-observation projection; otherwise ordered BFS under legacy contract",
    "trade": "ready iff fresh and offerPresent and now <= expiresAt and quantity <= inventory and quantity <= allowance; ready predicts quantity*price, otherwise zeros; settled=false always",
    "needs": "when fresh, awake and hunger > 0 choose edible food with greatest restoration then ascending ID; otherwise null; selected nonnull produces one explicitly allowed simulated receipt",
    "outcome": "reconcile receipt semantics in stdlib.md, with exact full reducer output"
  }
}
