{
  "id": "lanternkeeper",
  "name": "Lanternkeeper",
  "description": "Prioritizes a simulated street-lamp driver repair from weighted fault signals, independent inspection evidence, and an explicit local permission guard.",
  "graph": {
    "version": 1,
    "name": "Evidence-weighted street-lamp repair decision",
    "nodes": [
      {
        "id": "faultSignals",
        "op": "literal",
        "inputs": [],
        "params": {
          "value": [
            1,
            1,
            0.5
          ]
        }
      },
      {
        "id": "signalWeights",
        "op": "literal",
        "inputs": [],
        "params": {
          "value": [
            4,
            2,
            2
          ]
        }
      },
      {
        "id": "inspectionEvidence",
        "op": "literal",
        "inputs": [],
        "params": {
          "value": [
            {
              "source": "night-inspector",
              "claim": "faultConfirmed",
              "value": true
            },
            {
              "source": "bench-diagnostic",
              "claim": "faultConfirmed",
              "value": true
            }
          ]
        }
      },
      {
        "id": "repairPermitted",
        "op": "literal",
        "inputs": [],
        "params": {
          "value": true
        }
      },
      {
        "id": "falseGuard",
        "op": "literal",
        "inputs": [],
        "params": {
          "value": false
        }
      },
      {
        "id": "lampId",
        "op": "literal",
        "inputs": [],
        "params": {
          "value": "SIM-LAMP-017"
        }
      },
      {
        "id": "repairOperation",
        "op": "literal",
        "inputs": [],
        "params": {
          "value": "replace-driver"
        }
      },
      {
        "id": "faultScore",
        "op": "weightedMean",
        "inputs": [
          "faultSignals",
          "signalWeights"
        ],
        "params": {}
      },
      {
        "id": "maintenanceNeeded",
        "op": "compare",
        "inputs": [
          "faultScore"
        ],
        "params": {
          "operator": "gte",
          "value": 0.625
        }
      },
      {
        "id": "corroboration",
        "op": "evidence",
        "inputs": [
          "inspectionEvidence"
        ],
        "params": {
          "claim": "faultConfirmed"
        }
      },
      {
        "id": "evidenceState",
        "op": "get",
        "inputs": [
          "corroboration"
        ],
        "params": {
          "path": "state"
        }
      },
      {
        "id": "faultSupported",
        "op": "compare",
        "inputs": [
          "evidenceState"
        ],
        "params": {
          "operator": "eq",
          "value": "supported"
        }
      },
      {
        "id": "evidenceGuard",
        "op": "choose",
        "inputs": [
          "maintenanceNeeded",
          "faultSupported",
          "falseGuard"
        ],
        "params": {}
      },
      {
        "id": "repairGuard",
        "op": "choose",
        "inputs": [
          "repairPermitted",
          "evidenceGuard",
          "falseGuard"
        ],
        "params": {}
      },
      {
        "id": "repairPayload",
        "op": "report",
        "inputs": [
          "lampId",
          "repairOperation",
          "faultScore"
        ],
        "params": {
          "labels": [
            "lampId",
            "operation",
            "faultScore"
          ]
        }
      },
      {
        "id": "repairReceipt",
        "op": "action",
        "inputs": [
          "repairGuard",
          "repairPayload"
        ],
        "params": {
          "allowed": true,
          "action": "repairStreetLamp"
        }
      },
      {
        "id": "decision",
        "op": "report",
        "inputs": [
          "faultScore",
          "maintenanceNeeded",
          "corroboration",
          "repairPermitted",
          "repairReceipt"
        ],
        "params": {
          "labels": [
            "faultScore",
            "maintenanceNeeded",
            "evidence",
            "repairPermitted",
            "repair"
          ]
        }
      }
    ],
    "outputs": [
      "decision"
    ]
  },
  "skin": {
    "family": "filament",
    "accent": "#f4bc69"
  },
