module v1FrameTest {
  import v1Frame.* from "./v1-frame"

  run defaultsTest = init.then(render({...request(1,0,0,0), shape:Defaults}))
    .expect(safety and audit.originals.nth(0).owners == 12000 and audit.originals.nth(0).ridges == 3)
  run boundsTest = init.then(render(request(1,-1000000000,4000,2)))
    .then(render(request(1,1000000000,24000,4))).expect(safety and s.compilations == 1)
  run repeatDetachedTest = init.then(render(request(1,1,4000,2))).then(render(request(1,1,4000,2)))
    .then(mutate(0)).then(mutate(1)).then(render(request(1,1,4000,2)))
    .expect(safety and s.compilations == 1 and audit.originals.nth(0) == audit.originals.nth(2))
  run optionsShareBodyTest = init.then(render(request(1,0,4000,2))).then(render(request(1,1,12000,3)))
    .then(render(request(1,-1,24000,4))).expect(safety and s.compilations == 1)
  run fifoEvictionTest = init.then(32.reps(i => render(request(i+1,0,4000,2))))
    .then(render(request(1,1,4000,2))) // a hit must NOT promote source 1
    .then(render(request(33,0,4000,2))).then(render(request(1,0,4000,2)))
    .then(render(request(2,0,4000,2))).expect(safety and s.cache.length() == 32 and s.compilations == 35)
  run failedColdSampleTest = init.then(failSample(request(1,0,4000,2)))
    .then(render(request(1,0,4000,2))).then(failSample(request(1,1,4000,2)))
    .then(render(request(1,0,4000,2))).expect(safety and s.compilations == 2 and s.cache == List(1))
  run failedFullSampleTest = init.then(32.reps(i => render(request(i+1,0,4000,2))))
    .then(failSample(request(33,0,4000,2))).then(render(request(1,0,4000,2)))
    .then(render(request(33,0,4000,2))).expect(safety and s.compilations == 34 and s.cache.head() == 2)

  run lowBudgetTest = init.then(invalid(request(1,0,3999,2))).expect(safety and s == empty)
  run highBudgetTest = init.then(invalid(request(1,0,24001,2))).expect(safety and s == empty)
  run lowCrestsTest = init.then(invalid(request(1,0,4000,1))).expect(safety and s == empty)
  run highCrestsTest = init.then(invalid(request(1,0,4000,5))).expect(safety and s == empty)
  run lowPhaseTest = init.then(invalid(request(1,-1000000001,4000,2))).expect(safety and s == empty)
  run highPhaseTest = init.then(invalid(request(1,1000000001,4000,2))).expect(safety and s == empty)
  run fractionalBudgetTest = init.then(invalid({...request(1,0,4000,2),shape:FractionalBudget})).expect(safety)
  run fractionalCrestsTest = init.then(invalid({...request(1,0,4000,2),shape:FractionalCrests})).expect(safety)
  run nonfinitePhaseTest = init.then(invalid({...request(1,0,4000,2),shape:NonfinitePhase}))
    .then(invalid({...request(1,1,4000,2),shape:NonfinitePhase}))
    .then(invalid({...request(1,-1,4000,2),shape:NonfinitePhase})).expect(safety)
  run extraOptionTest = init.then(invalid({...request(1,0,4000,2),shape:ExtraOption})).expect(safety)
  run unknownArtifactTest = init.then(unknown(request(35,0,4000,2))).expect(safety and s == empty)
  run nonassemblyTest = init.then(unsupported(request(34,0,4000,2))).expect(safety and s == empty)
  run validationOrderTest = init.then(invalid(request(35,0,3999,2)))
    .then(invalid(request(34,1000000001,4000,2))).expect(safety and s == empty)
}
