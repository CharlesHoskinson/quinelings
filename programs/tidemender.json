              ],
              "duration": 5
            },
            {
              "id": "inspect",
              "depends": [
                "assemble"
              ],
              "duration": 1
            }
          ]
        }
      },
      {
        "id": "timeline",
        "op": "schedule",
        "inputs": [
          "jobs"
        ],
        "params": {}
      },
      {
        "id": "jobCount",
        "op": "length",
        "inputs": [
          "jobs"
        ],
        "params": {}
      },
      {
        "id": "makespan",
        "op": "get",
        "inputs": [
          "timeline"
        ],
        "params": {
          "path": "makespan"
        }
      },
      {
        "id": "withinWindow",
        "op": "compare",
        "inputs": [
          "makespan"
        ],
        "params": {
          "operator": "lte",
          "value": 14
        }
      },
      {
        "id": "plan",
        "op": "report",
        "inputs": [
          "timeline",
          "jobCount",
          "withinWindow"
        ],
        "params": {
          "labels": [
            "timeline",
            "jobCount",
            "withinWindow"
          ]
        }
      }
    ],
    "outputs": [
      "plan"
    ]
  },
