{
  "type": "object",
  "required": [
    "qdl",
    "family",
    "organ",
    "filament",
    "motion",
    "ink",
    "surface",
    "light",
    "composition"
  ],
  "additionalProperties": false,
  "properties": {
    "qdl": {
      "const": 1
    },
    "family": {
      "enum": [
        "filament",
        "jelly",
        "moth",
        "coral",
        "ribbon",
        "nautilus",
        "seed",
        "torus",
        "comet",
        "bloom"
      ]
    },
    "organ": {
      "type": "object",
      "required": [
        "model",
        "baseRadius",
        "degreeGain",
        "literalGain",
        "amplitudes"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "rosette"
        },
        "baseRadius": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.08
        },
        "degreeGain": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.006
        },
        "literalGain": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.003
        },
        "amplitudes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.45
          }
        }
      }
    },
    "filament": {
      "type": "object",
      "required": [
        "model",
        "bend",
        "frequencyGain",
        "ripple"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "pinned-sine"
        },
        "bend": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.08
        },
        "frequencyGain": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        },
        "ripple": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        }
      }
    },
    "motion": {
      "type": "object",
      "required": [
        "clock",
        "phaseRate",
        "reducedMotion"
      ],
      "additionalProperties": false,
      "properties": {
        "clock": {
          "const": "separate"
        },
        "phaseRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "reducedMotion": {
          "const": "freeze"
        },
        "rhythm": {
          "type": "object",
          "description": "Optional source-authored bounded rhythm. Omission keeps the source expression unchanged and uses the renderer fallback.",
          "required": [
            "model",
            "mode",
            "rate",
            "breath",
            "wave",
            "waveNumber",
            "lag",
            "asymmetry",
            "overtone"
          ],
          "additionalProperties": false,
          "properties": {
            "model": {
              "const": "coupled-harmonic"
            },
            "mode": {
              "enum": [
                "periodic",
                "quasiperiodic"
              ]
            },
            "rate": {
              "type": "number",
              "minimum": 0.25,
              "maximum": 2
            },
            "breath": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.18
            },
            "wave": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.18
            },
            "waveNumber": {
              "type": "number",
              "minimum": 0,
              "maximum": 4
            },
            "lag": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "asymmetry": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.8
            },
            "overtone": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.35
            }
          }
        },
        "gesture": {
          "$ref": "anatomy.schema.json#/$defs/gesture"
        }
      }
    },
    "ink": {
      "type": "object",
      "required": [
        "ghostAlpha",
        "secondaryAlpha",
        "ridgeAlpha",
        "neutral"
      ],
      "additionalProperties": false,
      "properties": {
        "ghostAlpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "secondaryAlpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ridgeAlpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "neutral": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        }
      }
    },
    "surface": {
      "type": "object",
      "required": [
        "model",
        "ribbons",
        "spread",
        "folds",
        "taper",
        "asymmetry",
        "depth",
        "twist",
        "phaseLag",
        "samples",
        "crests"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "folded-ribbon"
        },
        "ribbons": {
          "type": "integer",
          "minimum": 8,
          "maximum": 36
        },
        "spread": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 0.24
        },
        "folds": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9
        },
        "taper": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 2.5
        },
        "asymmetry": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.35
        },
        "depth": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.35
        },
        "twist": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "phaseLag": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "samples": {
          "type": "integer",
          "minimum": 4000,
          "maximum": 24000
        },
        "crests": {
          "type": "integer",
          "minimum": 3,
          "maximum": 6
        }
      }
    },
    "light": {
      "type": "object",
      "required": [
        "model",
        "recessAlpha",
        "crestAlpha",
        "depthContrast"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "density-crest"
        },
        "recessAlpha": {
          "type": "number",
          "minimum": 0.015,
          "maximum": 0.12
        },
        "crestAlpha": {
          "type": "number",
          "minimum": 0.16,
          "maximum": 0.65
        },
        "depthContrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.8
        }
      }
    },
    "composition": {
      "type": "object",
      "required": [
        "occupancy",
        "lean",
        "yaw",
        "pitch",
        "focus"
      ],
      "additionalProperties": false,
      "properties": {
        "occupancy": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 0.84
        },
        "lean": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "yaw": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "pitch": {
          "type": "number",
          "minimum": -0.5,
          "maximum": 0.5
        },
        "focus": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.8
        }
      }
    },
    "chroma": {
      "type": "object",
      "required": [
        "model",
        "palette",
        "strength"
      ],
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "material-territories"
        },
        "palette": {
          "const": "roles-1"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "lens": {
          "type": "object",
          "required": [
            "kind",
            "id",
            "label",
            "unit",
            "domain",
            "bindings"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "scalar"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "unit": {
              "type": "string",
              "minLength": 0,
              "maxLength": 24
            },
            "domain": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              },
              "description": "Executable validator requires increasing finite endpoints and finite positive width."
            },
            "threshold": {
              "type": "number",
              "description": "Executable validator requires threshold within inclusive domain."
            },
            "bindings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": [
                  "node",
                  "path"
                ],
                "additionalProperties": false,
                "properties": {
                  "node": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "path": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64,
                          "not": {
                            "enum": [
                              "__proto__",
                              "constructor",
                              "prototype"
                            ]
                          }
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 511
                        }
                      ]
                    }
                  }
                }
              },
              "description": "Executable validator requires unique nodes and validates node references against the task graph."
            }
          }
        }
      },
      "description": "Optional source-authored color fields. Omission preserves the neutral legacy material without rewriting source."
    },
    "anatomy": {
      "$ref": "anatomy.schema.json"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Experimental Quineling Design Language",
  "description": "Single evolving prototype schema. qdl.js additionally checks opacity order, radial positivity, scalar domain/threshold relations, unique bindings, and graph binding references.",
  "allOf": [
    {
      "if": {
        "required": [
          "anatomy"
        ]
      },
      "then": {
        "properties": {
          "motion": {
            "required": [
              "gesture"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "motion": {
            "required": [
              "gesture"
            ]
          }
        }
      },
      "then": {
        "required": [
          "anatomy"
        ]
      }
    }
  ]
}
