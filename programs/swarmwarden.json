{
  "id": "swarmwarden",
  "name": "Swarmwarden",
  "description": "Allocates a bounded resource pool to a FIFO request queue, reporting partial grants, remaining capacity, and requests that have not started. Earlier requests retain their place under scarcity.",
  "graph": {
    "version": 1,
    "name": "FIFO resource stewardship",
    "nodes": [
      {
        "id": "capacity",
        "op": "literal",
        "inputs": [],
        "params": {
          "value": 10
        }
      },
      {
        "id": "requests",
        "op": "literal",
        "inputs": [],
        "params": {
          "value": [
            {
              "id": "scouts",
              "amount": 3
            },
            {
              "id": "nursery",
              "amount": 4
            },
            {
              "id": "archive",
              "amount": 2
            }
          ]
        }
      },
      {
        "id": "allocation",
        "op": "allocate",
        "inputs": [
          "capacity",
          "requests"
        ],
        "params": {}
      },
      {
        "id": "grants",
        "op": "get",
        "inputs": [
          "allocation"
        ],
        "params": {
          "path": "grants"
        }
      },
      {
        "id": "remaining",
        "op": "get",
        "inputs": [
          "allocation"
        ],
        "params": {
          "path": "remaining"
        }
      },
      {
        "id": "positiveRequests",
        "op": "filter",
        "inputs": [
          "grants"
        ],
        "params": {
          "key": "requested",
          "operator": "gt",
          "value": 0
        }
      },
      {
        "id": "unstarted",
        "op": "filter",
        "inputs": [
          "positiveRequests"
        ],
        "params": {
          "key": "granted",
          "operator": "eq",
          "value": 0
        }
      },
      {
        "id": "depleted",
        "op": "compare",
        "inputs": [
          "remaining"
        ],
        "params": {
          "operator": "eq",
          "value": 0
        }
      },
      {
        "id": "receipt",
        "op": "report",
        "inputs": [
          "capacity",
          "allocation",
          "unstarted",
          "depleted"
        ],
        "params": {
          "labels": [
            "capacity",
            "allocation",
            "unstarted",
            "depleted"
          ]
        }
      }
    ],
    "outputs": [
      "receipt"
    ]
  },
  "skin": {
    "family": "coral",
    "accent": "#ef998c"
  },
